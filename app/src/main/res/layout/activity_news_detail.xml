<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Skip Button -->
    <TextView
        android:id="@+id/skipButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Skip"
        android:textColor="@color/red"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Select Country Label -->
    <TextView
        android:id="@+id/selectCountryLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Your Country"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/skipButton"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Country Select (Clickable Text) -->
    <TextView
        android:id="@+id/countrySelect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Country"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="@drawable/dropdown_background"
        android:drawableEnd="@drawable/ic_arrow_drop_down"
        android:gravity="center_vertical"
        android:drawableRight="@drawable/ic_arrow_drop_down"
        app:layout_constraintTop_toBottomOf="@id/selectCountryLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Preferred Language Label -->
    <TextView
        android:id="@+id/selectLanguageLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preferred Language"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/countrySelect"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Language Select -->
    <TextView
        android:id="@+id/languageSelect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Language"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="@drawable/dropdown_background"
        android:drawableEnd="@drawable/ic_arrow_drop_down"
        android:gravity="center_vertical"
        android:drawableRight="@drawable/ic_arrow_drop_down"
        app:layout_constraintTop_toBottomOf="@id/selectLanguageLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Interested Genres Label -->
    <TextView
        android:id="@+id/selectGenreLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Interested News Genres"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/languageSelect"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Genre Select -->
    <TextView
        android:id="@+id/genreSelect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Genre"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="@drawable/dropdown_background"
        android:drawableEnd="@drawable/ic_arrow_drop_down"
        android:gravity="center_vertical"
        android:drawableRight="@drawable/ic_arrow_drop_down"
        app:layout_constraintTop_toBottomOf="@id/selectGenreLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Next Button -->
    <Button
        android:id="@+id/nextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Next ➔"
        android:textColor="@color/blue"
        android:background="@android:color/transparent"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
